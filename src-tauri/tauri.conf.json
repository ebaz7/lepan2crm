{
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:3000",
    "distDir": "../dist"
  },
  "package": {
    "productName": "Lepan Warehouse System",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": true,
      "http": {
        "all": true,
        "request": true,
        "scope": ["http://**", "https://**"]
      },
      "shell": {
        "all": true,
        "open": true
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.lepan.warehouse.app",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "resources": [],
      "externalBin": [],
      "copyright": "Copyright © 2026 Lepan Covering & Texturing Manufacturing Company. All rights reserved.",
      "category": "Office",
      "shortDescription": "Lepan covering & texturing manufacturing company desktop client.",
      "longDescription": "Lepan intelligent manufacturing and warehouse system native desktop client with smart LAN/Cloud routing."
    },
    "updater": {
      "active": true,
      "dialog": true,
      "endpoints": [
        "https://ais-dev-wjlf3a3s2y7mgngiaxufff-97484218589.us-east1.run.app/api/desktop/updater.json",
        "http://localhost:3000/api/desktop/updater.json"
      ]
    },
    "security": {
      "csp": null
    },
    "windows": []
  }
}
